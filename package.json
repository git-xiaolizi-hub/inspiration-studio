{
  "name": "inspiration-assistant-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Inspiration Assistant v2 —— 纯前端、本地优先的记梦/创作辅助工具",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-ort-runtime.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/copy-ort-runtime.mjs",
    "postbuild": "node scripts/prune-dist.mjs",
    "check:no-dev-proxy": "node scripts/check-no-dev-proxy.mjs",
    "check:edges": "node scripts/check-edges.mjs",
    "check:m5b4": "node scripts/check-m5b4-evidence.mjs",
    "check:xy-mapping": "node scripts/check-xy-mapping.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:packs": "vitest run src/packs",
    "test:ai-config": "vitest run src/adapters/ai-models src/ui/ai-config",
    "test:video-adapter": "vitest run src/adapters/video src/ui/video",
    "test:storage": "vitest run src/core/storage",
    "test:records": "vitest run src/core/records src/core/media src/core/settings",
    "test:export": "vitest run src/core/backup",
    "test:canvas": "vitest run src/ui/pages/canvas.test.tsx src/core/canvas",
    "test:image": "vitest run src/adapters/image",
    "test:create": "vitest run src/ui/create",
    "test:backup": "vitest run src/core/backup",
    "test:asr": "vitest run src/adapters/asr src/workers/asr-worker-core.test.ts src/ui/components/asr-ui.test.tsx",
    "test:workflow": "vitest run src/ui/workflow",
    "model:whisper": "node scripts/fetch-whisper-model.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@xyflow/react": "^12.12.0",
    "dexie": "^4.4.6",
    "jszip": "^3.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
